function noise(d=.4,v=.08){if(!D.sound)return;const a=actx();if(!a)return;try{const n=Math.floor(a.sampleRate*d),b=a.createBuffer(1,n,a.sampleRate),x=b.getChannelData(0);for(let i=0;i<n;i++)x[i]=(Math.random()*2-1)*(1-i/n);const s=a.createBufferSource(),g=a.createGain();s.buffer=b;g.gain.value=v;s.connect(g);g.connect(a.destination);s.start()}catch(e){}}
const beep=(f,d,ty,v)=>tone(f,d||.1,ty||'sine',v||.04);
const SFX={tick:()=>tone(1000,.03,'square',.025),peg:()=>tone(1200+Math.random()*500,.03,'triangle',.025),start:()=>tone(300,.25,'sawtooth',.04,0,700),drop:()=>tone(700,.12,'sine',.05,0,350),
 coin:()=>{tone(1250,.07,'square',.04);tone(1750,.16,'square',.04,.07)},win:()=>[523,659,784,1047].forEach((f,i)=>tone(f,.2,'triangle',.06,i*.09)),low:()=>tone(220,.2,'sine',.04,0,150),
 crash:()=>{noise(.6,.12);tone(180,.6,'sawtooth',.08,0,35)},mega:()=>{noise(.25,.05);[392,523,659,784,1047,1319,1568].forEach((f,i)=>tone(f,.35,'triangle',.07,i*.1));tone(130,1,'sine',.08)}};
