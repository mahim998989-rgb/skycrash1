/* ---------- SKYCRASH ENGINE ---------- */
const R={id:D.S.round,ph:'wait',end:Date.now()+6000,t0:0,cp:1,m:1};
const P=[0,1].map(()=>({amt:100,auto:0,st:'idle',stake:0,msg:''}));
function pickCrash(){const S=D.S;let c=null;

 if(S.mode==='manual')c=+S.next;
 else if(S.mode==='queue'&&S.queue.length){c=+S.queue.shift();save()}
 if(!(c>=1))c=Math.min(200,Math.max(1,Math.floor(97/(1-Math.random()))/100)); /* random mode, server-side only */
 return Math.floor(c*100)/100}
function play(i){const p=P[i],S=D.S;
 if(!S.platOn||!S.crashOn)return toast('Game temporarily unavailable.');
 if(D.off)return toast('Player disabled by admin.');
 if(p.st!=='idle')return;
 if(R.ph==='fly')return toast('Round already started. Play in the next round.');
 if(!(Number.isInteger(p.amt)&&p.amt>=2&&p.amt<=S.diceMax))return toast('Bet must be from 2 to '+fmt(S.diceMax)+' Game Coins.');
 if(D.coins<p.amt)return toast('Not enough Game Coins.');
 if(!ledger('SKYCRASH_PLAY',-p.amt,'R'+R.id+'P'+i))return;
 p.st='live';p.stake=p.amt;p.msg='Play placed: '+fmt(p.amt);D.st.plays++;beep(440,.08);ui()}
function collect(i,at){const p=P[i];if(p.st!=='live'||R.ph!=='fly')return;
 const m=at||R.m,pay=Math.floor(p.stake*m);p.st='done';p.msg='Collected +'+fmt(pay)+' at '+mf(m);
 ledger('SKYCRASH_COLLECT',pay,'R'+R.id);D.st.collected+=pay;D.st.wins++;D.st.best=Math.max(D.st.best,m);save();sfxIn('crash',SFX.coin);ui()}
/* shared crash schedule: every player/device derives the same crash for round n, in sync with the clock */
const EPOCH=Date.UTC(2026,9,5),SEED=0x5CA1AB1E|0;
const h32=a=>{a^=a>>>16;a=Math.imul(a,0x7feb352d);a^=a>>>15;a=Math.imul(a,0x846ca68b);a^=a>>>16;return a>>>0};
const crashAt=n=>{const r=h32((SEED+Math.imul(n,0x9e3779b1))|0)/4294967296;return Math.min(200,Math.max(1,Math.floor(97/(1-r))/100))};
const fms=cp=>Math.floor(Math.log(cp)/.12*1000);
let GS={n:0,T:EPOCH};
function gcur(t){if(t<GS.T)GS={n:0,T:EPOCH};for(;;){const cp=crashAt(GS.n),tf=fms(cp);if(GS.T+6000+tf+3500>t)return{n:GS.n,T:GS.T,cp,tf};GS.T+=6000+tf+3500;GS.n++}}
function settle(n,cp,t){if(R.settled===n)return;R.settled=n;P.forEach(p=>{if(p.st==='live')p.msg='Crashed at '+mf(cp)+'. Play lost.';p.st='idle'});
 D.ch.unshift({id:n,m:cp,t});D.ch.length=Math.min(D.ch.length,60);if(R.seen===n)D.st.rounds++;save()}
function stick(t){const g=gcur(t),off=t-g.T;
 if(R.sn!==undefined&&R.sn!==g.n&&R.settled!==R.sn&&(R.seen===R.sn||P.some(p=>p.st==='live')))settle(R.sn,R.scp,t);
 R.sn=g.n;R.scp=g.cp;R.id=g.n;
 if(off<6000){if(R.ph!=='wait'){R.ph='wait';R.m=1;P.forEach(p=>{if(p.st==='done')p.st='idle'})}R.end=g.T+6000;
  const cc=Math.ceil((R.end-t)/1000);if(cc<=3&&cc>0&&cc!==R.lc){R.lc=cc;sfxIn('crash',SFX.tick)}}
 else if(off<6000+g.tf){if(R.ph!=='fly'){R.ph='fly';sfxIn('crash',SFX.start)}R.seen=g.n;R.t0=g.T+6000;R.cp=g.cp;
  let m=Math.min(g.cp,Math.floor(Math.exp(.12*(t-R.t0)/1000)*100)/100);
  P.forEach((p,i)=>{if(p.st==='live'&&p.auto&&m>=p.auto)collect(i,p.auto)});
  if(m!==R.m)sfxIn('crash',()=>tone(300+m*25,.05,'sine',.03));R.m=m}
 else{if(R.ph!=='crash'){R.ph='crash';R.m=g.cp;R.cp=g.cp;settle(g.n,g.cp,t);sfxIn('crash',SFX.crash)}R.end=g.T+6000+g.tf+3500}}
function tick(){const t=Date.now();if(D.S.mode==='schedule')return stick(t);
 if(R.ph==='wait'){const cc=Math.ceil((R.end-t)/1000);if(cc<=3&&cc>0&&cc!==R.lc){R.lc=cc;sfxIn('crash',SFX.tick)}if(t>=R.end){R.ph='fly';R.t0=t;R.cp=pickCrash();R.m=1;sfxIn('crash',SFX.start)}}
 else if(R.ph==='fly'){let m=Math.floor(Math.exp(.12*(t-R.t0)/1000)*100)/100;
  P.forEach((p,i)=>{if(p.st==='live'&&p.auto&&m>=p.auto)collect(i,p.auto)});
  if(m>=R.cp){R.m=R.cp;R.ph='crash';R.end=t+3500;
   P.forEach(p=>{if(p.st==='live'){p.msg='Crashed at '+mf(R.cp)+'. Play lost.'}p.st='idle'});
   D.ch.unshift({id:R.id,m:R.cp,t});D.ch.length=Math.min(D.ch.length,60);D.st.rounds++;D.S.round++;save();sfxIn('crash',SFX.crash)}
  else{if(Math.floor(m*10)!==Math.floor(R.m*10))sfxIn('crash',()=>tone(300+m*25,.05,'sine',.03));R.m=m}}
 else if(R.ph==='crash'&&t>=R.end){R.ph='wait';R.id=D.S.round;R.end=t+6000;R.m=1;P.forEach(p=>{if(p.st==='done')p.st='idle'})}
}
