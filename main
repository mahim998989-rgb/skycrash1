/* ---------- CRASH DRAWING ---------- */
const cv=$('#cv'),cx=cv.getContext('2d');let cw=0,ch=0;
function rs(){const d=devicePixelRatio||1;cw=cv.clientWidth;ch=cv.clientHeight;cv.width=cw*d;cv.height=ch*d;cx.setTransform(d,0,0,d,0,0)}
function drawCrash(t){if(!cw)rs();cx.clearRect(0,0,cw,ch);
 const el=R.ph==='wait'?0:R.ph==='fly'?(t-R.t0)/1000:Math.log(R.m)/.12,tm=Math.max(6,el),ym=Math.max(2,R.m);
 const X=s=>18+(s/tm)*(cw-60),Y=m=>ch-18-((m-1)/(ym-1))*(ch-60);
 cx.strokeStyle='#ffffff10';for(let i=1;i<5;i++){cx.beginPath();cx.moveTo(0,ch*i/5);cx.lineTo(cw,ch*i/5);cx.stroke()}
 const pts=[];for(let i=0;i<=50;i++){const s=el*i/50;pts.push([X(s),Y(Math.exp(.12*s))])}
 const [ex,ey]=pts[50],[bx,by]=pts[47],ang=Math.atan2(ey-by,ex-bx);
 cx.beginPath();cx.moveTo(pts[0][0],ch-18);pts.forEach(p=>cx.lineTo(p[0],p[1]));cx.lineTo(ex,ch-18);
 cx.fillStyle=R.ph==='crash'?'#ff3d5722':'#2f7bff33';cx.fill();
 cx.beginPath();pts.forEach((p,i)=>i?cx.lineTo(p[0],p[1]):cx.moveTo(p[0],p[1]));cx.strokeStyle=R.ph==='crash'?'#ff3d57':'#19d38a';cx.lineWidth=3;cx.stroke();
 if(R.ph==='crash')return;
 cx.save();cx.translate(ex,ey);cx.rotate(ang);cx.fillStyle='#e8eeff';
 cx.beginPath();cx.moveTo(16,0);cx.lineTo(-10,-6);cx.lineTo(-6,0);cx.lineTo(-10,6);cx.closePath();cx.fill();
 cx.fillStyle='#2f7bff';cx.beginPath();cx.moveTo(2,0);cx.lineTo(-8,-15);cx.lineTo(-11,-15);cx.lineTo(-5,0);cx.lineTo(-11,15);cx.lineTo(-8,15);cx.closePath();cx.fill();
 cx.fillStyle='#ffc233';cx.beginPath();cx.moveTo(-10,-2);cx.lineTo(-20-Math.random()*6,0);cx.lineTo(-10,2);cx.fill();cx.restore()}
