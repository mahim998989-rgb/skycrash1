/* ---------- FREE BALLS ---------- */
let bc=100,nb=1,balls=[],lastDrop=0,seq=0,hit=-1;
const PC=$('#pc'),px=PC.getContext('2d'),CX=180,Y0=24,G=N=>({DX:Math.min(25,Math.floor(320/N)),RH:Math.min(24,Math.floor(340/N))});
const sc=m=>m>=18?'#ff5a3c':m>=5?'#ffc233':m>=1?'#19d38a':m>0?'#2f7bff':'#4a5578';
function drop(){const S=D.S,t=Date.now();
 if(!S.platOn||!S.ballsOn)return toast('Game temporarily unavailable.');
 if(D.off)return toast('Player disabled by admin.');
 if(t-lastDrop<250)return null;lastDrop=t;
 if(!(Number.isInteger(bc)&&bc>=2&&bc>=S.minB&&bc<=S.maxB))return toast('Ball cost must be from '+Math.max(2,S.minB)+' to '+fmt(S.maxB)+'.');
 if(nb<1||nb>S.maxBalls)return toast('Invalid ball count.');
 const td=D.bl.filter(b=>b.d===today()).length;if(S.daily>0&&td+nb>S.daily)return toast('Daily ball limit reached.');
 if(D.coins<bc*nb)return toast('Not enough Game Coins.');
 for(let n=0;n<nb;n++){
  const id='B'+t.toString(36)+(++seq),path=[];let k=0;
  for(let r=0;r<S.slots.length-1;r++){const d=Math.random()<.5?1:0;path.push(d);k+=d}
  const mult=+S.slots[k],rew=Math.floor(bc*mult);
  if(!ledger('BALL_COST',-bc,id))return;
  if(rew>0)ledger('BALL_REWARD',rew,id);
  D.st.balls++;D.bl.unshift({id,t,d:today(),cost:bc,mult,rew,slot:k});D.bl.length=Math.min(D.bl.length,200);
  SFX.drop();pend+=rew;balls.push({id,N:S.slots.length-1,path,t0:t+n*220,k,rew,mult,cost:bc,done:false});}
 save();ui();return true}
function ballPos(b,now){const N=b.N,{DX,RH}=G(N),el=(now-b.t0)/120;if(el<0)return null;const r=Math.min(N,Math.floor(el)),f=el-r;
 let k=0;for(let i=0;i<r;i++)k+=b.path[i];
 const x0=CX+(2*k-r)*DX/2,y0=Y0+r*RH,yE=Y0+N*RH+18;if(r>=N)return{x:x0,y:yE,end:true};
 const k2=k+b.path[r],x1=CX+(2*k2-(r+1))*DX/2,y1=r+1>=N?yE:Y0+(r+1)*RH;
 return{x:x0+(x1-x0)*f,y:y0+(y1-y0)*f-Math.sin(Math.PI*f)*Math.min(7,RH/3)}}
function drawBalls(now){const N=D.S.slots.length-1,{DX,RH}=G(N),H=Y0+N*RH+50;if(PC.height!==H)PC.height=H;const c=px;c.clearRect(0,0,360,H);
 c.fillStyle='#8fb0ff';for(let r=0;r<N;r++)for(let j=0;j<=r;j++){c.beginPath();c.arc(CX+(2*j-r)*DX/2,Y0+r*RH,DX<22?2:2.6,0,7);c.fill()}
 const vert=DX<22,sw=DX-2,sh=vert?44:24;c.font='bold 9px system-ui';c.textAlign='center';
 D.S.slots.forEach((m,k)=>{const x=CX+(2*k-N)*DX/2,y=Y0+N*RH+2;c.fillStyle=sc(m);c.globalAlpha=k===hit?1:.85;c.beginPath();c.roundRect(x-sw/2,y,sw,sh,4);c.fill();c.globalAlpha=1;c.fillStyle='#04121f';
  if(vert){c.save();c.translate(x,y+sh/2);c.rotate(-Math.PI/2);c.fillText(m+'x',0,3);c.restore()}else c.fillText(m+'x',x,y+15)});
 balls=balls.filter(b=>{const p=ballPos(b,now);if(!p)return true;{const r=Math.floor((now-b.t0)/120);if(r!==b.lr&&r>=0&&r<b.N){b.lr=r;SFX.peg()}}
  if(p.end){pend=Math.max(0,pend-b.rew);hit=b.k;setTimeout(()=>hit=-1,500);$('#bmsg').textContent=`Ball ${b.mult}x → +${fmt(b.rew)} Game Coins`;b.mult>=1?SFX.win():SFX.low();ui();return false}
  c.fillStyle='#ffc233';c.beginPath();c.arc(p.x,p.y,5,0,7);c.fill();c.fillStyle='#fff8';c.beginPath();c.arc(p.x-1.5,p.y-1.5,1.7,0,7);c.fill();return true})}
